# Copy to .env and fill in real values locally. .env is gitignored; it must never be
# committed. In production these live in Secret Manager, injected as env vars at
# deploy time (deploy.sh) — never hardcoded, never logged.

# iron-session encryption key. Minimum 32 characters or the app refuses to boot
# (constitution, Application Stack). Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# GCP project id backing Cloud Run, Artifact Registry, and Firebase SQL Connect.
FIREBASE_PROJECT_ID=

# Firebase SQL Connect (Data Connect) emulator address for local development.
# Local: 127.0.0.1:9399
# Production: leave unset — the app talks to the deployed Cloud SQL instance instead.
DATACONNECT_EMULATOR_HOST=127.0.0.1:9399
