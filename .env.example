# Copy to .env and fill in real values locally. .env is gitignored; it must never be
# committed. In production these live in Secret Manager, injected as env vars at deploy
# time (deploy.sh) — never hardcoded, never logged.
#
# Secret ids are `${HTH_SECRET_PREFIX}_<VAR>`, default prefix `HTH`, matching the convention
# already in this Secret Manager. The prefix is why an unprefixed GEMINI_API_KEY belonging to
# another service is never picked up by accident.

# iron-session encryption key. Minimum 32 characters or the app refuses to boot
# (constitution, Application Stack). There is deliberately no default: a fallback secret is
# a forgeable session for every deployment that forgot to set one.
# Generate one with:
#   openssl rand -base64 32
# Production: secret id `HTH_SESSION_SECRET`.
SESSION_SECRET=

# Neon Postgres connection string for the checked-out branch. Pooled endpoint (-pooler).
#
# You normally do not fill this in by hand: `make db-up` runs `neon checkout`, which creates
# the branch if needed and writes the three NEON-managed values below. Every git branch gets
# its own copy-on-write database (research D7a), so a migration you are developing never
# touches another branch's data.
#
# Production: secret id `HTH_DATABASE_URL`.
DATABASE_URL=

# Direct (unpooled) endpoint for the same branch, written by `neon checkout`.
# Schema migrations belong here rather than on DATABASE_URL: the pooled endpoint is
# PgBouncer in transaction mode, which cannot hold the advisory lock node-pg-migrate takes.
DATABASE_URL_UNPOOLED=

# Which Neon branch `neon checkout` last pointed this file at. Informational.
NEON_BRANCH=

# Gemini API key. Not read by 001 — 002/003 use it for the review and TTS calls.
# Production: secret id `HTH_GEMINI_API_KEY`, bound only when it exists.
GEMINI_API_KEY=

# Submission rate limit (002, FR-048). Both optional; the defaults below live in code, so a
# deployment that sets neither still has a limit.
#
# These values are a starting guess, NOT a measurement. FR-051 forbids carrying a guessed limit
# to launch: they must be calibrated against a complete answer-then-ask cycle once 003 and 004
# exist (task T085). The cycle at participant pace must never trip the limit, and back-to-back
# cycles must trip it within three — a limit that never fires under abuse is not a limit.
#
# Configurable without a code change on purpose. Production: secret ids
# `HTH_RATE_LIMIT_MAX` and `HTH_RATE_LIMIT_WINDOW_SECONDS`, bound only when they exist.
HTH_RATE_LIMIT_MAX=20
HTH_RATE_LIMIT_WINDOW_SECONDS=3600
