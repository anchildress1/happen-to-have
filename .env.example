# Copy to .env and fill in real values locally. .env is gitignored; it must never be
# committed. In production these live in Secret Manager, injected as env vars at
# deploy time (deploy.sh) — never hardcoded, never logged.

# iron-session encryption key. Minimum 32 characters or the app refuses to boot
# (constitution, Application Stack). There is deliberately no default: a fallback
# secret is a forgeable session for every deployment that forgot to set one.
# Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Neon Postgres connection string for the checked-out branch.
#
# You normally do not fill this in by hand. `make db-up` runs `neon checkout`, which
# creates the branch if needed and writes DATABASE_URL, DATABASE_URL_UNPOOLED, and
# NEON_BRANCH into .env for you. Every git branch gets its own copy-on-write database
# (research D7a), so a migration you are developing never touches another branch's data.
#
# In production this comes from Secret Manager.
DATABASE_URL=
